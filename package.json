{
  "name": "mobile-dev-agent",
  "version": "1.1.0-beta.1",
  "description": "Install-once mobile development CLI for Termux, Ubuntu agents and FolderSynka",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run src --exclude '**/*.e2e.test.ts' --exclude '**/e2e.test.ts' --exclude '**/codexclient.test.ts'",
    "test:watch": "vitest src --exclude '**/*.e2e.test.ts' --exclude '**/e2e.test.ts' --exclude '**/codexclient.test.ts'",
    "test:live": "vitest run src/tests/*e2e.test.ts src/tests/codexclient.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "bin": {
    "mda": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/tests/**",
    "!dist/**/*.test.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
